{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mug:schema:mug.api-22.jobs:0",
  "title": "MUG API-22 Durable Jobs and Workers contracts, version 0",
  "$defs": {
    "AuthoringKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
      "maxLength": 128
    },
    "FirstClassJobKind": {
      "enum": [
        "compile-at-publish",
        "simulate-batch",
        "export-bundle-build",
        "replay-bundle-build"
      ]
    },
    "JobRequestSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-22.job-request"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "JobRequest": {
      "type": "object",
      "required": [
        "schema",
        "job_id",
        "job_kind",
        "work_key",
        "submitted_at"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/JobRequestSchemaRef"
        },
        "job_id": {
          "type": "string",
          "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "job_kind": {
          "$ref": "#/$defs/AuthoringKey"
        },
        "work_key": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        },
        "submitted_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        },
        "priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "JobRunSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-22.job-run"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "JobRun": {
      "type": "object",
      "required": [
        "schema",
        "job_id",
        "attempt",
        "status",
        "lease"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/JobRunSchemaRef"
        },
        "job_id": {
          "type": "string",
          "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "attempt": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PositiveSafeInteger"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "lease": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/LeaseRef"
        },
        "result_digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        },
        "started_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        }
      },
      "additionalProperties": false
    },
    "JobResultSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-22.job-result"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "JobResult": {
      "type": "object",
      "required": [
        "schema",
        "job_id",
        "work_key",
        "outcome",
        "completed_at"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/JobResultSchemaRef"
        },
        "job_id": {
          "type": "string",
          "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "work_key": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        },
        "outcome": {
          "enum": [
            "success",
            "failure"
          ]
        },
        "result_ref": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/ArtifactRef"
        },
        "completed_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        }
      },
      "additionalProperties": false
    },
    "FixtureManifestSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-22.jobs.fixture-manifest"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "FixtureCase": {
      "type": "object",
      "required": [
        "id",
        "instance",
        "schema_ref",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
          "maxLength": 160
        },
        "instance": {
          "type": "string",
          "pattern": "^(?:valid|invalid)/[a-z0-9][a-z0-9._-]*\\.json$",
          "maxLength": 256
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^urn:mug:schema:mug\\.api-22\\.jobs:0#/\\$defs/[A-Za-z][A-Za-z0-9]*$",
          "maxLength": 256
        },
        "validation_layer": {
          "enum": [
            "schema",
            "semantic"
          ]
        },
        "expect": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "expected_error": {
          "type": "object",
          "required": [
            "keyword",
            "instance_pointer"
          ],
          "properties": {
            "keyword": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "maxLength": 96
            },
            "instance_pointer": {
              "type": "string",
              "pattern": "^(?:/[^/]+)*$",
              "maxLength": 256
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "expect"
        ],
        "properties": {
          "expect": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "required": [
          "expected_error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "expected_error"
          ]
        }
      }
    },
    "FixtureManifest": {
      "type": "object",
      "required": [
        "schema",
        "manifest_version",
        "suite",
        "contract_version",
        "cases"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/FixtureManifestSchemaRef"
        },
        "manifest_version": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/SemVer"
        },
        "suite": {
          "const": "api-22-jobs"
        },
        "contract_version": {
          "const": 0
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureCase"
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "additionalProperties": false
    }
  }
}
