{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mug:schema:mug.api-08.conversation:0",
  "title": "MUG API-08 Conversation, Routing, and Delivery contracts, version 0",
  "$defs": {
    "AuthoringKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
      "maxLength": 128
    },
    "ChatMessageSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-08.chat-message"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "ChatMessage": {
      "type": "object",
      "required": [
        "schema",
        "message_id",
        "interaction_id",
        "channel_key",
        "author_actor_id",
        "sequence",
        "content_digest",
        "visibility",
        "idempotency_key",
        "submitted_at"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/ChatMessageSchemaRef"
        },
        "message_id": {
          "type": "string",
          "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "interaction_id": {
          "type": "string",
          "pattern": "^interaction_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "channel_key": {
          "$ref": "#/$defs/AuthoringKey"
        },
        "author_actor_id": {
          "type": "string",
          "pattern": "^actor_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sequence": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PositiveSafeInteger"
        },
        "content_digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        },
        "visibility": {
          "enum": [
            "public",
            "team",
            "private"
          ]
        },
        "idempotency_key": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/IdempotencyKey"
        },
        "submitted_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        }
      },
      "additionalProperties": false
    },
    "ConversationSegmentSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-08.conversation-segment"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "ConversationSegment": {
      "type": "object",
      "required": [
        "schema",
        "channel_key",
        "message_ids",
        "start_sequence",
        "end_sequence"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/ConversationSegmentSchemaRef"
        },
        "channel_key": {
          "$ref": "#/$defs/AuthoringKey"
        },
        "message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 512
        },
        "start_sequence": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PositiveSafeInteger"
        },
        "end_sequence": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PositiveSafeInteger"
        }
      },
      "additionalProperties": false
    },
    "ContextSnapshotSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-08.context-snapshot"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "ContextSnapshot": {
      "type": "object",
      "required": [
        "schema",
        "message_id",
        "model_request_digest",
        "included_message_ids",
        "captured_at"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/ContextSnapshotSchemaRef"
        },
        "message_id": {
          "type": "string",
          "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "model_request_digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        },
        "included_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 512
        },
        "captured_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        }
      },
      "additionalProperties": false
    },
    "TurnPolicySchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-08.turn-policy"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "TurnPolicy": {
      "type": "object",
      "required": [
        "schema",
        "channel_key",
        "activation",
        "max_model_activations_per_turn"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/TurnPolicySchemaRef"
        },
        "channel_key": {
          "$ref": "#/$defs/AuthoringKey"
        },
        "activation": {
          "enum": [
            "free",
            "round-robin",
            "mention",
            "moderated"
          ]
        },
        "max_model_activations_per_turn": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PositiveSafeInteger"
        }
      },
      "additionalProperties": false
    },
    "DeliveryReceiptSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-08.delivery-receipt"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "DeliveryReceipt": {
      "type": "object",
      "required": [
        "schema",
        "message_id",
        "recipient_actor_id",
        "delivered_sequence",
        "evidence_stream",
        "delivered_at"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/DeliveryReceiptSchemaRef"
        },
        "message_id": {
          "type": "string",
          "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "recipient_actor_id": {
          "type": "string",
          "pattern": "^actor_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "delivered_sequence": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PositiveSafeInteger"
        },
        "evidence_stream": {
          "enum": [
            "canonical",
            "experienced"
          ]
        },
        "delivered_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        }
      },
      "additionalProperties": false
    },
    "CandidateReplySetSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-08.candidate-reply-set"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "CandidateReplySet": {
      "type": "object",
      "required": [
        "schema",
        "channel_key",
        "prompt_message_id",
        "candidate_message_ids",
        "selected_message_id",
        "preference_response_id",
        "recorded_at"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/CandidateReplySetSchemaRef"
        },
        "channel_key": {
          "$ref": "#/$defs/AuthoringKey"
        },
        "prompt_message_id": {
          "type": "string",
          "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "candidate_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 2,
          "maxItems": 16
        },
        "selected_message_id": {
          "type": "string",
          "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "preference_response_id": {
          "type": "string",
          "pattern": "^prefresponse_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "recorded_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        }
      },
      "additionalProperties": false
    },
    "FixtureManifestSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-08.conversation.fixture-manifest"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "FixtureCase": {
      "type": "object",
      "required": [
        "id",
        "instance",
        "schema_ref",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
          "maxLength": 160
        },
        "instance": {
          "type": "string",
          "pattern": "^(?:valid|invalid)/[a-z0-9][a-z0-9._-]*\\.json$",
          "maxLength": 256
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^urn:mug:schema:mug\\.api-08\\.conversation:0#/\\$defs/[A-Za-z][A-Za-z0-9]*$",
          "maxLength": 256
        },
        "validation_layer": {
          "enum": [
            "schema",
            "semantic"
          ]
        },
        "expect": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "expected_error": {
          "type": "object",
          "required": [
            "keyword",
            "instance_pointer"
          ],
          "properties": {
            "keyword": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "maxLength": 96
            },
            "instance_pointer": {
              "type": "string",
              "pattern": "^(?:/[^/]+)*$",
              "maxLength": 256
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "expect"
        ],
        "properties": {
          "expect": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "required": [
          "expected_error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "expected_error"
          ]
        }
      }
    },
    "FixtureManifest": {
      "type": "object",
      "required": [
        "schema",
        "manifest_version",
        "suite",
        "contract_version",
        "cases"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/FixtureManifestSchemaRef"
        },
        "manifest_version": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/SemVer"
        },
        "suite": {
          "const": "api-08-conversation"
        },
        "contract_version": {
          "const": 0
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureCase"
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "additionalProperties": false
    }
  }
}
