{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mug:schema:mug.api-03.identity-enrollment:0",
  "title": "MUG API-03 Identity, Enrollment, and Launch contracts, version 0",
  "$defs": {
    "EnrollmentSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-03.enrollment"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "Enrollment": {
      "type": "object",
      "required": [
        "schema",
        "enrollment_id",
        "study_id",
        "principal",
        "status",
        "created_at",
        "version"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/EnrollmentSchemaRef"
        },
        "enrollment_id": {
          "type": "string",
          "pattern": "^enrollment_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "study_id": {
          "type": "string",
          "pattern": "^study_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "principal": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PrincipalRef"
        },
        "status": {
          "enum": [
            "active",
            "withdrawn",
            "completed"
          ]
        },
        "created_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        },
        "version": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/VersionStamp"
        }
      },
      "additionalProperties": false
    },
    "LaunchTicketSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-03.launch-ticket"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "LaunchTicket": {
      "type": "object",
      "required": [
        "schema",
        "ticket_handle",
        "study_id",
        "deployment",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/LaunchTicketSchemaRef"
        },
        "ticket_handle": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PublicHandle"
        },
        "study_id": {
          "type": "string",
          "pattern": "^study_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "deployment": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/DeploymentRevisionRef"
        },
        "issued_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        },
        "expires_at": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/UtcInstant"
        }
      },
      "additionalProperties": false
    },
    "ExternalIdentityLinkSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-03.external-identity-link"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "ExternalIdentityLink": {
      "type": "object",
      "required": [
        "schema",
        "enrollment_id",
        "provider",
        "external_subject_handle",
        "data_handling"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/ExternalIdentityLinkSchemaRef"
        },
        "enrollment_id": {
          "type": "string",
          "pattern": "^enrollment_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provider": {
          "enum": [
            "prolific",
            "mturk",
            "oidc",
            "institution",
            "contact"
          ]
        },
        "external_subject_handle": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/PublicHandle"
        },
        "data_handling": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/DataHandlingRef"
        }
      },
      "additionalProperties": false
    },
    "FixtureManifestSchemaRef": {
      "type": "object",
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "const": "mug.api-03.fixture-manifest"
        },
        "version": {
          "const": 0
        },
        "digest": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "FixtureCase": {
      "type": "object",
      "required": [
        "id",
        "instance",
        "schema_ref",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
          "maxLength": 160
        },
        "instance": {
          "type": "string",
          "pattern": "^(?:valid|invalid)/[a-z0-9][a-z0-9._-]*\\.json$",
          "maxLength": 256
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^urn:mug:schema:mug\\.api-03\\.identity-enrollment:0#/\\$defs/[A-Za-z][A-Za-z0-9]*$",
          "maxLength": 256
        },
        "validation_layer": {
          "enum": [
            "schema",
            "semantic"
          ]
        },
        "expect": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "expected_error": {
          "type": "object",
          "required": [
            "keyword",
            "instance_pointer"
          ],
          "properties": {
            "keyword": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "maxLength": 96
            },
            "instance_pointer": {
              "type": "string",
              "pattern": "^(?:/[^/]+)*$",
              "maxLength": 256
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "expect"
        ],
        "properties": {
          "expect": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "required": [
          "expected_error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "expected_error"
          ]
        }
      }
    },
    "FixtureManifest": {
      "type": "object",
      "required": [
        "schema",
        "manifest_version",
        "suite",
        "contract_version",
        "cases"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/FixtureManifestSchemaRef"
        },
        "manifest_version": {
          "$ref": "urn:mug:schema:mug.shared-kernel:0#/$defs/SemVer"
        },
        "suite": {
          "const": "api-03-identity-enrollment"
        },
        "contract_version": {
          "const": 0
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureCase"
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "additionalProperties": false
    }
  }
}
