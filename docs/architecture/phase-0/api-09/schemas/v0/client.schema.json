    "FixtureCase": {
      "type": "object",
      "required": [
        "id",
        "instance",
        "schema_ref",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
          "maxLength": 160
        },
        "instance": {
          "type": "string",
          "pattern": "^(?:valid|invalid)/[a-z0-9][a-z0-9._-]*\\.json$",
          "maxLength": 256
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^urn:mug:schema:mug\\.api-09\\.client:0#/\\$defs/[A-Za-z][A-Za-z0-9]*$",
          "maxLength": 256
        },
        "validation_layer": {
          "enum": [
            "schema",
            "semantic"
          ]
        },
        "expect": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "expected_error": {
          "type": "object",
          "required": [
            "keyword",
            "instance_pointer"
          ],
          "properties": {
            "keyword": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "maxLength": 96
            },
            "instance_pointer": {
              "type": "string",
              "pattern": "^(?:/[^/]+)*$",
              "maxLength": 256
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "expect"
        ],
        "properties": {
          "expect": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "required": [
          "expected_error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "expected_error"
          ]
        }
      }
    },
    "FixtureManifest": {
      "type": "object",
